# Copy to `.env` and fill in values. Never commit `.env`.
# All variables are read through the config module (see docs/development/setup.md § Configuration).
# autoclipper reads `.env` from the directory you run it in (normally the repository root), and
# environment variables override it. An empty value means "unset".
# Workers and hosted deployments can set these same names in their environment or deployment
# secret configuration; a .env file is optional when the environment supplies the values.
# Windows paths: write them without quotes, even with spaces, or with forward slashes; for a
# network share, \\server\share\data unquoted or //server/share/data. Inside quotes, backslash
# escapes are decoded: "C:\new" would contain a newline, and '\\server' would become '\server'.

# --- Twitch API (https://dev.twitch.tv/console) ------------------------------
# Register an application, then copy its Client ID and generate a Client Secret.
# Used with the client-credentials flow to get an app access token. Only commands that call the
# Twitch API need them.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Storage roots ------------------------------------------------------------
# Root for raw/interim/processed data. Defaults to ./data if unset. Relative paths are relative to
# the directory you run autoclipper from; an absolute path lets several worktrees share one folder.
AUTOCLIPPER_DATA_DIR=./data
# Root for trained models, eval reports and exported clips. Defaults to ./artifacts.
AUTOCLIPPER_ARTIFACTS_DIR=./artifacts

# --- Chat hashing ------------------------------------------------------------
# Salt for hashing chatter and clip-creator IDs (HMAC-SHA256), used for unique-chatter counts.
# Use a long random value: uv run python -c "import secrets; print(secrets.token_hex(32))"
# Pseudonymized messages are kept under data/interim/chat/. Hashes need to be
# consistent within each VOD for unique-chatter counts; each collector can use
# its own salt. Reuse the collected table across machines. Never commit the salt.
AUTOCLIPPER_CHAT_HASH_SALT=

# --- Logging -----------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR or CRITICAL (any letter case). Sets AutoClipper's own log level;
# other libraries only log warnings and errors.
AUTOCLIPPER_LOG_LEVEL=INFO

# --- Export -------------------------------------------------------------------
# The part of the source frame that vertical (9:16) clips show, as x,y,width,height in fractions
# (0-1) of the source width and height from the top-left corner, e.g. 0.25,0,0.5,1 for the
# middle half. A region that isn't 9:16 is cropped to 9:16 around its center. Leave empty for a
# center crop.
AUTOCLIPPER_EXPORT_REGION=
# Facecam rectangle for the stacked vertical layout (facecam on top, gameplay below), as
# x,y,width,height fractions (0-1), e.g. 0.02,0.04,0.22,0.28. Channel presets in
# configs/channels.yaml can also supply this per streamer.
AUTOCLIPPER_EXPORT_FACECAM_REGION=
# The faster-whisper model that captions exported clips (tiny, base, small, medium, large-v3).
# Needs the captions extra: uv sync --extra captions. Bigger is more accurate and slower.
AUTOCLIPPER_WHISPER_MODEL=base

# --- Phase 2 audio-event features (#63, opt-in) ------------------------------
# Default number of highest-scoring windows evaluated by `autoclipper audio-events --scores`.
# Audio-event extraction is opt-in and needs the optional extra: uv sync --extra audio-events.
AUTOCLIPPER_AUDIO_EVENTS_TOP_K=100

# --- Phase 2 shortlist speech features (#64, opt-in) -------------------------
# Default number of top-ranked shortlisted candidates transcribed by `autoclipper speech-features`
# or `autoclipper analyze --speech-features`. Needs the optional extra: uv sync --extra captions.
AUTOCLIPPER_SPEECH_TOP_N=50

# --- Optional LLM title polisher (#65, off by default) -------------------------
# Rewords the top 20 moment titles with any OpenAI-compatible chat completions API: a hosted
# provider or a local server (llama.cpp, Ollama, LM Studio, vLLM). Off unless both the base URL
# and the model are set; there is no default provider and no network call while they are empty.
# Only each moment's deterministic title and reason plus aggregate numbers (chat rates, loudness,
# viewer-clip counts, duration) are sent: never chat text, usernames, the VOD title or channel,
# file paths or audio (docs/data/data-governance.md § 2). Any error or timeout keeps the
# deterministic titles; ranking, scores and reasons never change.
# Base URL that /chat/completions is appended to, e.g. http://localhost:11434/v1
AUTOCLIPPER_TITLE_LLM_BASE_URL=
AUTOCLIPPER_TITLE_LLM_MODEL=
# Bearer token for that API, if it needs one (local servers usually don't). Never commit it.
AUTOCLIPPER_TITLE_LLM_API_KEY=
# Total seconds the one request per analysis may take (1-60).
AUTOCLIPPER_TITLE_LLM_TIMEOUT_S=10

# --- Backend API (autoclipper serve) -------------------------------------------
# Browser origins allowed to call the API, comma-separated (scheme, host and port, no path).
# Defaults to the local Next.js dev server.
AUTOCLIPPER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Managed external tools (FFmpeg, FFprobe, TwitchDownloaderCLI) -------------
# AutoClipper discovers each tool in order: explicit path below -> managed tools folder -> PATH.
# Leave empty to use the per-user default managed tools folder:
#   Windows: %LOCALAPPDATA%\AutoClipper\tools
#   macOS:   ~/Library/Application Support/AutoClipper/tools
#   Linux:   $XDG_DATA_HOME/autoclipper/tools (or ~/.local/share/autoclipper/tools)
AUTOCLIPPER_TOOLS_DIR=
# Optional explicit executable paths; when set, they win over managed tools and PATH.
AUTOCLIPPER_FFMPEG_PATH=
AUTOCLIPPER_FFPROBE_PATH=
AUTOCLIPPER_TWITCH_DOWNLOADER_PATH=
