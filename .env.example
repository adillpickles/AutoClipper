# Copy to `.env` and fill in values. Never commit `.env`.
# All variables are read through the config module (see docs/development/setup.md § Configuration).
# autoclipper reads `.env` from the directory you run it in (normally the repository root), and
# environment variables override it. An empty value means "unset".
# Windows paths: write them without quotes, even with spaces, or with forward slashes; for a
# network share, \\server\share\data unquoted or //server/share/data. Inside quotes, backslash
# escapes are decoded: "C:\new" would contain a newline, and '\\server' would become '\server'.

# --- Twitch API (https://dev.twitch.tv/console) ------------------------------
# Register an application, then copy its Client ID and generate a Client Secret.
# Used with the client-credentials flow to get an app access token. Only commands that call the
# Twitch API need them.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Local storage ------------------------------------------------------------
# Root for raw/interim/processed data. Defaults to ./data if unset. Relative paths are relative to
# the directory you run autoclipper from; an absolute path lets several worktrees share one folder.
AUTOCLIPPER_DATA_DIR=./data
# Root for trained models, eval reports and exported clips. Defaults to ./artifacts.
AUTOCLIPPER_ARTIFACTS_DIR=./artifacts

# --- Privacy -----------------------------------------------------------------
# Secret salt for pseudonymizing chatters and clip creators (HMAC-SHA256).
# Use a long random value: uv run python -c "import secrets; print(secrets.token_hex(32))"
# OQ-9 decides retention and linkage scope. If persisted cross-machine joins are
# approved, share the dataset's salt privately; changing it breaks those joins.
# Aggregate-only parsing may use hashes transiently. Never commit the salt.
AUTOCLIPPER_CHAT_HASH_SALT=

# --- Logging -----------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR or CRITICAL (any letter case). Sets AutoClipper's own log level;
# other libraries only log warnings and errors.
AUTOCLIPPER_LOG_LEVEL=INFO
